{
  "name": "nexus-player-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:vendor && vite",
    "build": "npm run build:vendor && vite build",
    "build:vendor": "PUPPETEER_SKIP_DOWNLOAD=true npm --prefix ../vendor/butterchurn install && npm --prefix ../vendor/butterchurn run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "andr": "NO_STRIP=true tauri android build --target aarch64",
    "android-build": "NO_STRIP=true tauri android build --target aarch64",
    "android-build-all": "NO_STRIP=true tauri android build",
    "android-install": "bash android-deploy.sh",
    "android-deploy": "NO_STRIP=true tauri android build --target aarch64 && bash android-deploy.sh",
    "bld": "NO_STRIP=true tauri build",
    "install": "bash ./install.sh",
    "start": "tauri dev"
  },
  "dependencies": {
    "@fontsource/oxanium": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.4.2",
    "@vueuse/core": "^14.1.0",
    "butterchurn": "file:../vendor/butterchurn",
    "butterchurn-presets": "^2.4.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/devtools-api": "^8.1.1",
    "sass": "^1.97.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^2.1.10"
  }
}
