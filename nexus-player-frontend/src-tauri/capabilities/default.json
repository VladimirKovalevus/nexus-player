{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "soundcloud-challenge"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "dialog:default",
    "fs:allow-read",
    "fs:allow-exists",
    "vkLogin:allow-open",
    "soundCloudChallenge:allow-open",
    "soundCloudChallenge:allow-close",
    "core:event:default",
    "core:window:allow-destroy",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }]
    }
  ]
}
